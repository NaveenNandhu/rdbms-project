# Server Configuration
PORT=5000
NODE_ENV=production

# Database (SQLite default, or postgresql://user:pass@host:port/dbname)
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# AI Vision & Tutor Provider (gemini or openai or builtin)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Uploads directory
UPLOAD_DIR="./uploads"
